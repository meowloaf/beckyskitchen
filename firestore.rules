rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
          && exists(
            /databases/$(database)/documents/admins/$(request.auth.uid)
          )
          && get(
            /databases/$(database)/documents/admins/$(request.auth.uid)
          ).data.enabled == true;
    }

    function validProduct(data) {
      return data.keys().hasAll([
            'name',
            'description',
            'price',
            'imageUrl',
            'category'
          ])
          && data.keys().hasOnly([
            'name',
            'description',
            'price',
            'imageUrl',
            'category'
          ])
          && data.name is string
          && data.description is string
          && data.price is number
          && data.price >= 0
          && data.imageUrl is string
          && data.category is string;
    }

    function validNewOrder(data) {
      return data.keys().hasAll([
            'userId',
            'customerName',
            'phone',
            'fulfillment',
            'address',
            'items',
            'total',
            'currency',
            'status',
            'createdAt'
          ])
          && data.keys().hasOnly([
            'userId',
            'customerName',
            'phone',
            'fulfillment',
            'address',
            'items',
            'total',
            'currency',
            'status',
            'createdAt'
          ])
          && data.userId == request.auth.uid
          && data.customerName is string
          && data.phone is string
          && data.fulfillment in ['pickup', 'delivery']
          && data.address is string
          && (data.fulfillment == 'delivery' ? data.address.size() > 0 : true)
          && data.items is list
          && data.items.size() > 0
          && data.items.size() <= 50
          && data.total is number
          && data.total >= 0
          && data.currency == 'PHP'
          && data.status == 'pending'
          && data.createdAt == request.time;
    }

    function validStatusTransition(oldStatus, newStatus) {
      return (oldStatus == 'pending'
              && newStatus in ['accepted', 'declined'])
          || (oldStatus == 'accepted' && newStatus == 'ready')
          || (oldStatus == 'ready' && newStatus == 'completed');
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update: if isAdmin() && validProduct(request.resource.data);
      allow delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow create: if signedIn() && validNewOrder(request.resource.data);
      allow read: if signedIn()
          && (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'updatedAt'])
          && request.resource.data.updatedAt == request.time
          && validStatusTransition(
            resource.data.status,
            request.resource.data.status
          );
      allow delete: if false;
    }

    match /admins/{userId} {
      allow get: if signedIn() && request.auth.uid == userId;
      allow list, create, update, delete: if false;
    }
  }
}
